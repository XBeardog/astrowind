---

<Layout metadata={metadata}>
  <Hero
    tagline="Products"
    title="产品中心"
    compact
    i18n={{ title: 'products.hero.title' }}
  />

  <!-- 分类筛选栏 + 产品列表 -->
  <WidgetWrapper containerClass="max-w-7xl mx-auto !py-0">
    <div class="flex flex-wrap items-center gap-3 pt-2 pb-3 border-b border-gray-100 dark:border-slate-800">
      <span class="text-sm font-semibold text-gray-500 dark:text-slate-400 mr-2" data-i18n="products.filter.label">产品分类：</span>
      <button class="px-4 py-1.5 rounded-full text-sm font-medium bg-primary text-white shadow-sm" data-filter="all" data-i18n="products.filter.all">全部</button>
      <button class="px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-primary hover:text-white transition-colors" data-filter="结构件" data-i18n="products.filter.structural">结构件/紧固件</button>
      <button class="px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-primary hover:text-white transition-colors" data-filter="包胶模具" data-i18n="products.filter.overmold">包胶模具</button>
      <button class="px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-primary hover:text-white transition-colors" data-filter="潮玩玩具" data-i18n="products.filter.toy">潮玩/玩具</button>
      <button class="px-4 py-1.5 rounded-full text-sm font-medium bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-primary hover:text-white transition-colors" data-filter="大型壳体" data-i18n="products.filter.large">大型壳体</button>
    </div>

    <div id="product-list" class="pt-3">
      <ProductGrid products={products} columns={3} />
    </div>
  </WidgetWrapper>

  <CallToAction
    tagline="下一页"
    title="业务服务"
    subtitle="模具定制、注塑生产、试模服务、定制塑料件，一眼了解我们能做什么"
    i18n={{
      tagline: 'products.cta.tagline',
      title: 'products.cta.title',
      subtitle: 'products.cta.subtitle',
      actions: ['products.cta.btn'],
    }}
    actions={[
      {
        variant: 'primary',
        text: '查看业务服务',
        href: '/services',
        icon: 'tabler:arrow-right',
      },
    ]}
  />
</Layout>

<script is:inline data-astro-rerun>
  const filterButtons = document.querySelectorAll('[data-filter]');
  const productCards = document.querySelectorAll('#product-list .group');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') ?? '';

      // 更新按钮状态
      filterButtons.forEach((b) => {
        b.classList.remove('bg-primary', 'text-white', 'shadow-sm');
        b.classList.add('bg-gray-100', 'dark:bg-slate-800', 'text-gray-600', 'dark:text-slate-300');
      });
      btn.classList.add('bg-primary', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-gray-100', 'dark:bg-slate-800', 'text-gray-600', 'dark:text-slate-300');

      // 筛选产品
      productCards.forEach((card) => {
        const category = card.querySelector('.group span')?.textContent ?? '';
        if (filter === 'all' || category.includes(filter)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
