    tags: ['螺纹精密', '装配级', '多原料'],
    href: '/contact',
  },
  {
    image: 'https://images.unsplash.com/photo-1612631512728-1e2f0b066b35?w=600&h=450&fit=crop',
    alt: '卡扣配件模具',
    title: '卡扣配件模具',
    category: '结构件',
    description: '塑胶装配组件、卡扣配件定制模具，配合公差精准，批量注塑品质稳定。',
    tags: ['卡扣结构', '批量注塑', '互换性强'],
    href: '/contact',
  },
  {
    image: 'https://images.unsplash.com/photo-1606293459339-aa5d34a7b0e1?w=600&h=450&fit=crop',
    alt: '防滑外壳包胶模具',
    title: '防滑外壳包胶模具',
    category: '包胶模具',
    description: '二次软硬胶包胶注塑，解决粘合、封胶、溢料痛点，杜绝分层、溢边。',
    tags: ['软硬胶包胶', '防滑', '密封性好'],
    href: '/contact',
  },
  {
    image: 'https://images.unsplash.com/photo-1581235720704-06d3acfcb36f?w=600&h=450&fit=crop',
    alt: '工具握持配件包胶模具',
    title: '工具握持配件包胶模具',
    category: '包胶模具',
    description: '工具握持部位包胶定制，舒适防滑，耐用不脱胶，支持批量注塑量产。',
    tags: ['握持舒适', '耐磨', '量产稳定'],
    href: '/contact',
  },
  {
    image: 'https://images.unsplash.com/photo-1558877385-8c1b8b1cc3bb?w=600&h=450&fit=crop',
    alt: '盲盒公仔模具',
    title: '盲盒公仔模具',
    category: '潮玩玩具',
    description: '精细曲面加工，精准控制分型线，降低后期打磨成本，装配间隙紧密。',
    tags: ['精细曲面', '分型线精准', '免打磨'],
    href: '/contact',
  },
  {
    image: 'https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?w=600&h=450&fit=crop',
    alt: '潮玩手办模具',
    title: '潮玩手办模具',
    category: '潮玩玩具',
    description: '复杂曲面潮玩手办模具开发，高精度加工，支持拼装益智玩具批量注塑。',
    tags: ['复杂曲面', '高精度', '批量注塑'],
    href: '/contact',
  },
  {
    image: 'https://images.unsplash.com/photo-1565514020179-026b92b2d70b?w=600&h=450&fit=crop',
