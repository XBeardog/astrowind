---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: '业务服务',
};

const businesses = [
  {
    icon: 'tabler:tool',
    title: '模具定制',
    desc: '各类塑胶模具设计与制造，支持定制化需求',
    items: ['模具结构设计', 'CNC数控加工', '抛光装配', '绝大部分工序自主完成'],
  },
  {
    icon: 'tabler:package',
    title: '注塑生产',
    desc: '全吨位注塑机覆盖，从小件到大壳体批量注塑成型',
    items: ['全吨位注塑机覆盖', '标准化成型工艺', '大批量稳定产出', '品质一致性保障'],
  },
  {
    icon: 'tabler:clipboard-check',
    title: '试模服务',
    desc: '新模试模、缺陷整改、参数调试到量产验收全流程检测',
    items: ['新模初次试模', '尺寸检测校准', '外观缺陷整改', '量产前最终验收'],
  },
  {
    icon: 'tabler:box',
    title: '定制塑料件',
    desc: '从开模到成品一站式交付，客户只需提供需求即可拿到成品',
    items: ['开模+注塑一体', '无需对接多家供应商', '缩短供应链', '降低综合成本'],
  },
];
---

<Layout metadata={metadata}>
  <script is:inline define:vars={{ i18nVars: {} }}>
    document.body.setAttribute('data-i18n-vars', JSON.stringify(i18nVars));
  </script>

  <Hero tagline="Services" title="业务服务" compact i18n={{ title: 'services.hero.title' }} />

  <!-- 四大业务 -->
  <WidgetWrapper containerClass="max-w-7xl mx-auto !py-2">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-5xl mx-auto">
      {businesses.map((b, bIdx) => (
        <div class="flex flex-col bg-white dark:bg-slate-900 rounded-lg p-5 border border-gray-100 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-2.5 mb-2">
            <Icon name={b.icon} class="w-6 h-6 text-primary flex-shrink-0" />
            <h3 class="text-base font-bold text-gray-900 dark:text-white" data-i18n={`services.b${bIdx + 1}.title`}>{b.title}</h3>
          </div>
          <p class="text-sm text-gray-500 dark:text-slate-400 leading-snug mb-3" data-i18n={`services.b${bIdx + 1}.desc`}>{b.desc}</p>
          <ul class="mt-auto space-y-1">
            {b.items.map((item, iIdx) => (
              <li class="flex items-center gap-1.5 text-sm text-gray-600 dark:text-slate-300" data-i18n={`services.b${bIdx + 1}.i${iIdx + 1}`}>
                <Icon name="tabler:check" class="w-3.5 h-3.5 text-primary flex-shrink-0" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </WidgetWrapper>

  <CallToAction
    tagline="下一页"
    title="工厂实拍"
    subtitle="走进溢隆模具工厂，亲眼见证模塑一体化生产实力"
    i18n={{
      tagline: 'services.cta.tagline',
      title: 'services.cta.title',
      subtitle: 'services.cta.subtitle',
      actions: ['services.cta.btn'],
    }}
    actions={[
      { variant: 'primary', text: '查看工厂实拍', href: '/factory', icon: 'tabler:arrow-right' },
    ]}
    classes={{ container: '!py-4' }}
  />
</Layout>
